# GPU UUIDs from `nvidia-smi -L` (CDI names nvidia.com/gpu=<UUID>)
HECATE_GB300_UUID=GPU-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
HECATE_RTX_UUID=GPU-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
# local copy of the Hugging Face weights repo (chronarion/GLM-5.3-Hecate)
HECATE_WEIGHTS=/data/models/GLM-5.3-Hecate
# HECATE_MAX_SEQ_LEN=262144
# HECATE_CACHE_TOKENS=524288
# HECATE_PLACEMENT=tier-144-85-far27-mtp256
# HECATE_RTX_I4=0
# system RAM in GB that keeps conversations pushed out of GPU memory (README, "Returning conversations")
# HECATE_SYSMEM_KV_GB=200
